# Артефакты сборки PlatformIO
.pio/

# Настройки редактора с локальными путями
.vscode/

# Локальные файлы KiCad (настройки просмотра, автобэкапы, кэш)
*.kicad_prl
fp-info-cache
*-backups/
.history/
.history_trim/

# Скомпилированные прошивки — публикуются через GitHub Releases, не в git
bin/
*.o
*.d
*.elf
*.map
*.lst
*.bin
*.hex

# Локальный архив старых версий (не для публикации)
archive/

# Локальные ресурсы (логотип, графика) — не для публикации
assets/

# Прочее
__pycache__/
*.pyc
Desktop.ini
Thumbs.db
